---
// src/pages/[lang]/index.astro
import Base from '../../layouts/Base.astro';
import HomeContent from '../../components/HomeContent.astro';
import { getLangFromUrl } from '../../i18n/utils';
import { ui as uiTranslations } from '../../i18n/ui';

export async function getStaticPaths() {
  return Object.keys(uiTranslations).map((lang) => ({ params: { lang } }));
}

const lang = getLangFromUrl(Astro.url);

// The English homepage canonicalizes to the prefix-less root ("/"), which
// serves identical content — avoids a duplicate-content split across "/" and "/en/".
const meta = lang === 'en' ? { canonical: 'https://poscardigital.com/' } : {};
---

<Base meta={meta}>
  <HomeContent lang={lang} />
</Base>
