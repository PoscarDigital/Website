---
// Root homepage. Serves the default language (English) directly at "/" so the
// bare domain renders content immediately instead of redirecting to "/en/".
// Khmer still lives under "/km/"; the language picker switches to it.
// Base derives lang from the URL — "/" has no prefix, so it falls back to the
// default language (en), and Nav/Footer render their English links.
import Base from '../layouts/Base.astro';
import HomeContent from '../components/HomeContent.astro';
import { defaultLang } from '../i18n/ui';
---

<Base>
  <HomeContent lang={defaultLang} />
</Base>
