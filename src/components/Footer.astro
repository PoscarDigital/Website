---
// Import translations if necessary
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<footer class="bg-slate-600 text-white p-8 md:p-12">
  <!-- Container for all footer content -->
  <div class="container mx-auto grid grid-cols-1 md:grid-cols-3 gap-8">
    
    <!-- Company Info -->
    <div>
      <h3 class="text-h3 mb-4">POSCAR Digital</h3>
      <p class="text-gray-200 text-caption mb-4">
        {t('footer.description')}
      </p>
      <p class="text-gray-200 text-caption">© {new Date().getFullYear()} POSCAR Digital Co., LTD. All rights reserved.</p>
    </div>

    <!-- Quick Links -->
    <div>
      <h3 class="text-h3 mb-4">{t('footer.quick_links')}</h3>
      <ul class="space-y-3 text-caption">
        <li><a href={lang === 'en' ? '/' : `/${lang}/`} class="text-gray-200 hover:text-white transition-colors">{t('nav.home')}</a></li>
        <li><a href={`/${lang}/solutions/`} class="text-gray-200 hover:text-white transition-colors">{t('nav.products_services')}</a></li>
        <li><a href={`/${lang}/about/`} class="text-gray-200 hover:text-white transition-colors">{t('nav.about')}</a></li>
        <li><a href={`/${lang}/blogs/`} class="text-gray-200 hover:text-white transition-colors">{t('nav.blogs')}</a></li>
        <li><a href={`/${lang}/contact/`} class="text-gray-200 hover:text-white transition-colors">{t('nav.contact_us')}</a></li>
      </ul>
    </div>

    <!-- Contact and Social Media -->
    <div>
      <h3 class="text-h3 mb-4">{t('footer.contact_us')}</h3>
      <ul class="space-y-3 text-gray-200 text-caption">
        <li>{t('footer.phone')}: <a href="tel:+85595569568" class="hover:text-white">+855-95-569-568</a></li>
        <li>{t('footer.email')}: <a href="mailto:info@poscardigital.com" class="hover:text-white">info@poscardigital.com</a></li>
        <li>{t('footer.address')}: C-7 Building, 6th &amp; 7th Floor, Street Vimean Ahha, Phnom Penh, Cambodia 121001</li>
      </ul>
      <div class="flex space-x-4 mt-6">
        <a href="https://www.facebook.com/poscardigital" target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="text-gray-200 hover:text-white transition-colors">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.78-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.44 2.89h-2.34v6.99A10 10 0 0 0 22 12Z" /></svg>
        </a>
        <a href="https://twitter.com/poscardigital" target="_blank" rel="noopener noreferrer" aria-label="X (Twitter)" class="text-gray-200 hover:text-white transition-colors">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.75 3h3.07l-6.7 7.66L22 21h-6.17l-4.83-6.32L5.47 21H2.4l7.17-8.2L2 3h6.33l4.37 5.78L17.75 3Zm-1.08 16.2h1.7L7.4 4.73H5.58L16.67 19.2Z" /></svg>
        </a>
        <a href="https://www.linkedin.com/company/poscardigital" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="text-gray-200 hover:text-white transition-colors">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z" /></svg>
        </a>
        <a href="https://www.instagram.com/poscardigital" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="text-gray-200 hover:text-white transition-colors">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41a3.72 3.72 0 0 1-1.38-.9 3.72 3.72 0 0 1-.9-1.38c-.16-.42-.36-1.06-.41-2.23C2.17 15.58 2.16 15.2 2.16 12s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.42 2.17 8.8 2.16 12 2.16ZM12 0C8.74 0 8.33.01 7.05.07 5.78.13 4.9.33 4.14.63a5.88 5.88 0 0 0-2.13 1.38A5.88 5.88 0 0 0 .63 4.14C.33 4.9.13 5.78.07 7.05.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.06 1.27.26 2.15.56 2.91.31.79.72 1.46 1.38 2.13a5.88 5.88 0 0 0 2.13 1.38c.76.3 1.64.5 2.91.56C8.33 23.99 8.74 24 12 24s3.67-.01 4.95-.07c1.27-.06 2.15-.26 2.91-.56a5.88 5.88 0 0 0 2.13-1.38 5.88 5.88 0 0 0 1.38-2.13c.3-.76.5-1.64.56-2.91.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95c-.06-1.27-.26-2.15-.56-2.91a5.88 5.88 0 0 0-1.38-2.13A5.88 5.88 0 0 0 19.86.63C19.1.33 18.22.13 16.95.07 15.67.01 15.26 0 12 0Zm0 5.84a6.16 6.16 0 1 0 0 12.32 6.16 6.16 0 0 0 0-12.32ZM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8Zm6.4-11.85a1.44 1.44 0 1 0 0 2.88 1.44 1.44 0 0 0 0-2.88Z" /></svg>
        </a>
      </div>
    </div>
  </div>
</footer>