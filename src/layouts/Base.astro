---
import { getLangFromUrl } from "../i18n/utils";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import "@fontsource/kantumruy-pro/400.css";
import "@fontsource/kantumruy-pro/500.css";
import "@fontsource/kantumruy-pro/700.css";
import "../styles/global.css";

const lang = getLangFromUrl(Astro.url);
const SITE = "https://poscardigital.com";

// Same page in each language, for hreflang. "/" and "/en/..." are English;
// "/km/..." is Khmer. The English homepage lives at "/".
const pathRest = Astro.url.pathname.replace(/^\/(en|km)(?=\/|$)/, "") || "/";
const altUrl = (code: string) =>
  code === "en" && pathRest === "/" ? `${SITE}/` : `${SITE}/${code}${pathRest}`;
const ogLocales: Record<string, string> = { en: "en_US", km: "km_KH" };

// Default SEO meta tags
const defaultMeta = {
  title: "POSCAR Digital - Smart Education & ERP Solutions in Cambodia",
  description: "POSCAR Digital is a leading provider of smart education, accounting, attendance, and ERP solutions in Cambodia. Discover our innovative platforms including Wiki School and Vithean.",
  keywords: "POSCAR Digital, digital solutions, Cambodia, Wiki School, Vithean, ERP solutions, smart education, accounting software",
  ogImage: `${SITE}/og-image.png`,
  ogType: "website",
  twitterCard: "summary_large_image",
  twitterSite: "@poscardigital",
  twitterCreator: "@poscardigital",
  canonical: `https://poscardigital.com${Astro.url.pathname}`,
  robots: "index, follow",
  viewport: "width=device-width, initial-scale=1",
  charset: "utf-8",
  language: lang,
  author: "POSCAR Digital",
  publisher: "POSCAR Digital",
  geo: {
    region: "KH",
    position: "11.5564;104.9282",
    placename: "Phnom Penh"
  }
};

// Allow pages to override default meta tags
const { meta = {} } = Astro.props;
const finalMeta = { ...defaultMeta, ...meta };

// Structured Data for AI and Search Engines
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://poscardigital.com/#organization",
      "name": "POSCAR Digital",
      "url": "https://poscardigital.com",
      "logo": {
        "@type": "ImageObject",
        "url": "https://poscardigital.com/android-chrome-512x512.png"
      },
      "sameAs": [
        "https://www.facebook.com/people/Poscar-Digital/100076631097443/",
        "https://x.com/poscardigital",
        "https://www.linkedin.com/company/poscar"
      ],
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "C-7 Building, 6th & 7th Floor, Street Vimean Ahha, Kien Klaing Village",
        "addressLocality": "Phnom Penh",
        "addressRegion": "Phnom Penh",
        "postalCode": "121001",
        "addressCountry": "KH"
      },
      "contactPoint": {
        "@type": "ContactPoint",
        "telephone": "+855-95-569-568",
        "contactType": "customer service",
        "email": "info@poscardigital.com",
        "availableLanguage": ["en", "km"]
      }
    },
    {
      "@type": "SoftwareApplication",
      "@id": "https://poscardigital.com/#wikischool",
      "name": "Wiki School",
      "applicationCategory": "EducationApplication",
      "operatingSystem": "Web",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "description": "Comprehensive education management platform that revolutionizes how schools and educational institutions operate.",
      "provider": {
        "@id": "https://poscardigital.com/#organization"
      }
    },
    {
      "@type": "SoftwareApplication",
      "@id": "https://poscardigital.com/#vithean",
      "name": "Vithean",
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "Web",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "description": "Advanced ERP solution designed to streamline business operations and enhance productivity.",
      "provider": {
        "@id": "https://poscardigital.com/#organization"
      }
    },
    {
      "@type": "WebSite",
      "@id": "https://poscardigital.com/#website",
      "url": "https://poscardigital.com",
      "name": "POSCAR Digital",
      "publisher": {
        "@id": "https://poscardigital.com/#organization"
      },
      "inLanguage": lang
    },
    {
      "@type": "WebPage",
      "@id": `${finalMeta.canonical}#webpage`,
      "url": finalMeta.canonical,
      "name": finalMeta.title,
      "description": finalMeta.description,
      "isPartOf": {
        "@id": "https://poscardigital.com/#website"
      },
      "about": {
        "@id": "https://poscardigital.com/#organization"
      },
      "inLanguage": lang
    }
  ]
};
---

<html lang={finalMeta.language}>
  <head>
    <meta charset={finalMeta.charset} />
    <meta name="viewport" content={finalMeta.viewport} />
    
    <!-- Primary Meta Tags -->
    <title>{finalMeta.title}</title>
    <meta name="title" content={finalMeta.title} />
    <meta name="description" content={finalMeta.description} />
    <meta name="keywords" content={finalMeta.keywords} />
    <meta name="author" content={finalMeta.author} />
    <meta name="publisher" content={finalMeta.publisher} />
    <meta name="robots" content={finalMeta.robots} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={finalMeta.ogType} />
    <meta property="og:url" content={finalMeta.canonical} />
    <meta property="og:title" content={finalMeta.title} />
    <meta property="og:description" content={finalMeta.description} />
    <meta property="og:image" content={finalMeta.ogImage} />
    <meta property="og:locale" content={ogLocales[finalMeta.language] ?? "en_US"} />
    {Object.keys(ogLocales).filter((c) => c !== finalMeta.language).map((c) => (
      <meta property="og:locale:alternate" content={ogLocales[c]} />
    ))}
    <meta property="og:site_name" content="POSCAR Digital" />
    
    <!-- Twitter -->
    <meta name="twitter:card" content={finalMeta.twitterCard} />
    <meta name="twitter:url" content={finalMeta.canonical} />
    <meta name="twitter:title" content={finalMeta.title} />
    <meta name="twitter:description" content={finalMeta.description} />
    <meta name="twitter:image" content={finalMeta.ogImage} />
    <meta name="twitter:site" content={finalMeta.twitterSite} />
    <meta name="twitter:creator" content={finalMeta.twitterCreator} />
    
    <!-- Canonical URL -->
    <link rel="canonical" href={finalMeta.canonical} />

    <!-- Language alternates -->
    <link rel="alternate" hreflang="en" href={altUrl("en")} />
    <link rel="alternate" hreflang="km" href={altUrl("km")} />
    <link rel="alternate" hreflang="x-default" href={altUrl("en")} />
    
    <!-- Geo Tags -->
    <meta name="geo.region" content={finalMeta.geo.region} />
    <meta name="geo.position" content={finalMeta.geo.position} />
    <meta name="ICBM" content={finalMeta.geo.position} />
    <meta name="geo.placename" content={finalMeta.geo.placename} />
    
    <!-- Structured Data for AI and Search Engines -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    
    <!-- Favicons + manifest -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#C1272D" />

  </head>
  <body class="bg-gray-100 text-gray-900 font-kantumruy">
    <Nav />

    <main class="font-kantumruy">
      <slot />
    </main>
    <Footer />
  </body>
</html>